      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256526891.3,
      "text": "Lancer Gate. Crossfire. Lancers fire across the lane, never along it.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256530278.7,
      "text": "That was close, and close is billable. Thank you for your proximity.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256530298.8,
      "text": "Your first live lock! Intel filed. Every scan helps the Authority map its lanes.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256531934.7,
      "text": "Oh! That crystal is a recovered flight recorder. Please don't open it.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256537268,
      "text": "You're opening it. It's opening.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256539710.2,
      "text": "You're opening it. It's opening.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256540510.3,
      "text": "Recording. Pilot zero one two one. Last Approach. Weapon status: cold.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    }
  ]
}