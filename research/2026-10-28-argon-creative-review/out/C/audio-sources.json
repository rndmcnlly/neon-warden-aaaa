    {
      "k": "sub",
      "epoch": 1793256684944.6,
      "text": "Hello, and welcome to Lane Authority onboarding!",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256688058.1,
      "text": "I am your onboarding assistant, and I will be with you every step of the way.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256693053.9001,
      "text": "Every single step.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256694229.2,
      "text": "Your contract has been countersigned! Payment is issued on completion of contract.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256699204.2,
      "text": "Completion of contract is defined in Appendix F, which is available on request.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256703991.4001,
      "text": "Let's start with movement! Movement is how you get from one place to another.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256708866.4001,
      "text": "Please fly to the left.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256710316.1,
      "text": "Please fly to the left.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256712650.1,
      "text": "Great job pressing the left key! Now, for your next challenge: press the right key.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256718616.7,
      "text": "I believe in you. Take all the time you need.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256721857.7,
      "text": "I believe in you. Take all the time you need.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256721933.2,
      "text": "Wonderful! Now up. And now down. You have flown in all four directions.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256727674.6,
      "text": "That is every direction we offer.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
