    {
      "k": "sub",
      "epoch": 1793256509770.6,
      "text": "Outer Drift. Scouts ahead. Scout fire is light, and completely unprovoked.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256511571.6,
      "text": "Outer Drift. Scouts ahead. Scout fire is light, and completely unprovoked.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256512472.9001,
      "text": "A disarm. That is forty percent.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256513888.9001,
      "text": "That was close, and close is billable. Thank you for your proximity.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256514551,
      "text": "Oh! That crystal is a recovered flight recorder. Please don't open it.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256519889.5,
      "text": "You're opening it. It's opening.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256522328.3,
      "text": "You're opening it. It's opening.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793256523119.5,
      "text": "Recording. Pilot zero one two one. Last Approach. Weapon status: cold.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    }
  ]
