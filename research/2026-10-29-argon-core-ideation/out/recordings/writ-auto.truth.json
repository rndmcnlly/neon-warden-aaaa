   "layer": "",
   "line": ""
  },
  {
   "t": 1.537,
   "k": "sub",
   "text": "Outer Drift. Scouts ahead. Scout fire is light, and completely unprovoked.",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 2.481,
   "k": "sub",
   "text": "A disarm. That is forty percent.",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 2.607,
   "k": "sub",
   "text": "That was close, and close is billable. Thank you for your proximity.",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 2.881,
   "k": "sub",
   "text": "Oh! That crystal is a recovered flight recorder. Please don't open it.",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 8.206,
   "k": "sub",
   "text": "You're opening it. It's opening.",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 11.443,
   "k": "sub",
   "text": "Recording. Pilot zero one two one. Last Approach. Weapon status: cold.",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 19.13,
   "k": "sub",
   "text": "Pilot zero one two one, your weapon is cold. Please fire. Please fire.",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 25.607,
   "k": "sub",
   "text": "Pilot, please.",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 26.902,
   "k": "sub",
   "text": "You stopped! Why did you stop?! Nobody stops! Nobody EVER stops!",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 32.636,
   "k": "sub",
   "text": "Look! The little ships! No guns! They fly my lanes because I keep them free! FREE!",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 38.019,
   "k": "sub",
   "text": "Do you know what free means?!",
   "visible": false,
   "layer": "scripted",
   "line": ""
  }
 ],
