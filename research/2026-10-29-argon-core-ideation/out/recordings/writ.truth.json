 "subs": [
  {
   "t": 0.123,
   "k": "sub",
   "text": "",
   "visible": false,
   "layer": "",
   "line": ""
  },
  {
   "t": 1.63,
   "k": "sub",
   "text": "Outer Drift. Scouts ahead. Scout fire is light, and completely unprovoked.",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 4.546,
   "k": "sub",
   "text": "Your first live lock! Intel filed. Every scan helps the Authority map its lanes.",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 7.449,
   "k": "sub",
   "text": "That was close, and close is billable. Thank you for your proximity.",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 9.657,
   "k": "sub",
   "text": "A disarm. That is forty percent.",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 12.107,
   "k": "sub",
   "text": "I am sure you had a reason, and I am sure it was a good one.",
   "visible": false,
   "layer": "scripted",
   "line": ""
  },
  {
   "t": 18.109,
   "k": "sub",
   "text": "Clean disarm. The scouts call that a handshake. We call it non-standard.",
   "visible": false,
   "layer": "ambient",
   "line": ""
  },
  {
   "t": 22.058,
   "k": "sub",
   "text": "Pilot, you're fine. I'm going to keep saying that, and I need it to stay true.",
   "visible": false,
   "layer": "ambient",
   "line": ""
  }
 ],
