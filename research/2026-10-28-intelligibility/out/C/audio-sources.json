  "subs": [
    {
      "k": "sub",
      "epoch": 1793254317160.2,
      "text": "",
      "visible": false,
      "layer": "",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254318604.7,
      "text": "Shatter Belt. Divers incoming. Did you know?",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254320725.5,
      "text": "Shatter Belt. Divers incoming. Did you know?",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254321628.0999,
      "text": "A disarm. That is forty percent.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254323466.5999,
      "text": "I am sure you had a reason, and I am sure it was a good one.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254324207.2,
      "text": "That was close, and close is billable. Thank you for your proximity.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254328059,
      "text": "That was close, and close is billable. Thank you for your proximity.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254330408.3,
      "text": "Another one off the books. Well, onto the books. You know what I mean.",
      "visible": true,
      "layer": "ambient",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254331752.8,
      "text": "Your first live lock! Intel filed. Every scan helps the Authority map its lanes.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254337360.3,
      "text": "Your first live lock! Intel filed. Every scan helps the Authority map its lanes.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254340150.0999,
      "text": "If you see unarmed ships in the lanes, please ignore them.",
      "visible": true,
      "layer": "ambient",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254343890.3,
      "text": "They are not paying customers yet.",
      "visible": true,
      "layer": "ambient",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254344834.8,
      "text": "Oh! That crystal is a recovered flight recorder. Please don't open it.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254349393.3,
      "text": "You're opening it. It's opening.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254351479.8,
      "text": "You're opening it. It's opening.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254352279.0999,
      "text": "Recording. Pilot zero one two one. Last Approach. Weapon status: cold.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    }
  ]
}