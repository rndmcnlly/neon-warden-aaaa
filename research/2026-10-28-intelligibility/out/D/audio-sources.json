  ],
  "subs": [
    {
      "k": "sub",
      "epoch": 1793254355893.0999,
      "text": "",
      "visible": false,
      "layer": "",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254356056.2998,
      "text": "Warning. The Warden approaches. This is it, Pilot. Everything we trained for.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254361219.7,
      "text": "Remember the briefing.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254362699,
      "text": "Remember the briefing.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254363207.2,
      "text": "The Warden.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254364007.4,
      "text": "The Warden.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254365027,
      "text": "STOP! Stop right there! Do you have ANY idea how long it takes to grow a scout?!",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254370146.2,
      "text": "That is not the voice from the briefing.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254372243,
      "text": "Wait. Wait, wait, wait. Your gun is cold. Why is your gun cold?!",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254377928.5999,
      "text": "The last cold gun was zero one two one. Oh. Oh, no. You're the next number.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254384260.5,
      "text": "The last cold gun was zero one two one. Oh. Oh, no. You're the next number.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254384660.0999,
      "text": "And your gun is FULL. I can hear it humming from here.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254388314.4,
      "text": "You carried a Writ the whole way and you never spent it.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254392109.7998,
      "text": "You carried a Writ the whole way and you never spent it.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254392708.2,
      "text": "I am the Warden! I keep these lanes! And I am SO TIRED of saying that!",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254397280.4,
      "text": "Proceed with the engagement, Pilot.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254399528.0999,
      "text": "Statements by the Warden are not covered by your contract.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254403204.5,
      "text": "Statements by the Warden are not covered by your contract.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254407208.4,
      "text": "You're not shooting. You are NOT SHOOTING. Is this a trick? Is it a trick?!",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254407302.5999,
      "text": "That was close, and close is billable. Thank you for your proximity.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254408710.9,
      "text": "My POD! Do you have ANY idea how long it takes to grow a pod?!",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254412635.5999,
      "text": "My POD! Do you have ANY idea how long it takes to grow a pod?!",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254414983.7998,
      "text": "Pilot, your weapon shows no activity during a contracted engagement.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254420202.7998,
      "text": "This has been escalated.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254422042.7,
      "text": "This has been escalated.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254426759.5999,
      "text": "Recall authorization requested. Please hold. Your call is important to us.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254432045.9,
      "text": "Recall authorization requested. Please hold. Your call is important to us.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254438192.5,
      "text": "Count the rings, zero one two two! Count what's LEFT!",
      "visible": true,
      "layer": "ambient",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254438490.9,
