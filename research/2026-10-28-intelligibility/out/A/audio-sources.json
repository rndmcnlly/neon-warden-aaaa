  "subs": [
    {
      "k": "sub",
      "epoch": 1793254246007.9,
      "text": "",
      "visible": false,
      "layer": "",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254246148.5,
      "text": "I believe in you. I've also attached the terms of that belief.",
      "visible": true,
      "layer": "ambient",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254247443.4,
      "text": "Outer Drift. Scouts ahead. Scout fire is light, and completely unprovoked.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254249540.5,
      "text": "I believe in you. I've also attached the terms of that belief.",
      "visible": true,
      "layer": "ambient",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254250072.2,
      "text": "I believe in you. I've also attached the terms of that belief.",
      "visible": false,
      "layer": "ambient",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254250443.5,
      "text": "A disarm. That is forty percent.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254251931.9,
      "text": "Your first live lock! Intel filed. Every scan helps the Authority map its lanes.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254254171.3,
      "text": "That was close, and close is billable. Thank you for your proximity.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254258026.9,
      "text": "That was close, and close is billable. Thank you for your proximity.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254259748.9,
      "text": "That was a whisker. A paid whisker!",
      "visible": true,
      "layer": "ambient",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254262027.3,
      "text": "That was a whisker. A paid whisker!",
      "visible": false,
      "layer": "ambient",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254267842.1,
      "text": "Another one off the books. Well, onto the books. You know what I mean.",
      "visible": true,
      "layer": "ambient",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254268136.2,
      "text": "Oh! That crystal is a recovered flight recorder. Please don't open it.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254272705.1,
      "text": "You're opening it. It's opening.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    }
  ]
}