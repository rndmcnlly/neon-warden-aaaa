    {
      "k": "sub",
      "epoch": 1793253584851.4,
      "text": "Here we go again! I've pre-filled your forms. Optimistically.",
      "visible": true,
      "layer": "ambient",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793253586165.0999,
      "text": "Gun Lanes. Turrets online.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793253588051,
      "text": "These lanes were built for free passage, three centuries ago. No tollgates anywhere.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793253589199.0999,
      "text": "That was close, and close is billable. Thank you for your proximity.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793253591809.9,
      "text": "Your first live lock! Intel filed. Every scan helps the Authority map its lanes.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    }
  ]
