    {
      "k": "sub",
      "epoch": 1793254098314.5,
      "text": "Hello, and welcome to Lane Authority onboarding!",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254101456.7,
      "text": "I am your onboarding assistant, and I will be with you every step of the way.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254106495.4,
      "text": "Every single step.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254107678.4,
      "text": "Your contract has been countersigned! Payment is issued on completion of contract.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254113062.4,
      "text": "Completion of contract is defined in Appendix F, which is available on request.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254118246.0999,
      "text": "Let's start with movement! Movement is how you get from one place to another.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254123120.3,
      "text": "Please fly to the left.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254124570.4,
      "text": "Please fly to the left.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254125554.0999,
      "text": "No, your other left. Let's try that direction again.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254128938.5,
      "text": "Great job pressing the left key! Now, for your next challenge: press the right key.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254135013,
      "text": "I believe in you. Take all the time you need.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254138304,
      "text": "I believe in you. Take all the time you need.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254138687.0999,
      "text": "Wonderful! Now up. And now down. You have flown in all four directions.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254143604.2,
      "text": "That is every direction we offer.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254145886.7,
      "text": "That is every direction we offer.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254146838.0999,
      "text": "Your ship is large and beautiful, but only the small glowing gem at its center can",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254152229.5,
      "text": "be hit. Please protect the gem. The gem is you.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254155320.2,
      "text": "Hold focus to fly slowly and precisely.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254158104.0999,
      "text": "Focus is for threading the gem between bullets. Let's practice. Focus. Good.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254163520.7,
      "text": "Still focusing. Great.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254165087.5,
      "text": "Still focusing. Great.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254169404.5,
      "text": "Now, let's learn to fire! Hold fire to release bullets. Bullets go up.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254174445.5,
      "text": "Up is where the problems are.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254176528.5,
      "text": "Up is where the problems are.",
      "visible": false,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254191529.2,
      "text": "Take all the time you need. I am timing it, but take all the time you need.",
      "visible": true,
      "layer": "scripted",
      "line": ""
    },
    {
      "k": "sub",
      "epoch": 1793254196737.0999,
      "text": "Take all the time you need. I am timing it, but take all the time you need.",
