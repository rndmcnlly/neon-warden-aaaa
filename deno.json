{
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ],
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "tasks": {
    "dev": "deno run -A npm:vite@8.3.1",
    "build": "deno run -A npm:vite@8.3.1 build",
    "preview": "deno run -A npm:vite@8.3.1 preview",
    "check": "deno check src/ tests/ vite.config.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test tests/",
    "ci": "deno fmt --check && deno lint && deno task check && deno task test && deno task build"
  },
  "exclude": [
    "node_modules",
    "dist",
    ".git",
    "reference",
    "research",
    "vo",
    "sfx",
    "art"
  ],
  "imports": {
    "vite": "npm:vite@8.3.1",
    "three": "npm:three@0.186.1",
    "@types/three": "npm:@types/three@0.186.0",
    "@std/assert": "jsr:@std/assert@1"
  },
  "nodeModulesDir": "auto"
}
