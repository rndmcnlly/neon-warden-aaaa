{
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ],
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "tasks": {
    "vo:sync": "deno run --allow-read=vo/out,public/vo --allow-write=public/vo scripts/sync_vo.ts",
    "dev": "deno task vo:sync && deno run -A npm:vite@8.3.1",
    "build": "deno task vo:sync && deno run -A npm:vite@8.3.1 build",
    "preview": "deno run -A npm:vite@8.3.1 preview",
    "check": "deno check src/ tests/ scripts/ vite.config.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test --allow-read tests/",
    "qa": "deno run -A --no-lock qa/qa.ts",
    "qa:static": "deno run -A --no-lock qa/qa.ts static",
    "qa:reel": "deno run -A --no-lock qa/qa.ts reel",
    "qa:topic": "deno run -A --no-lock qa/qa.ts topic",
    "qa:list": "deno run -A --no-lock qa/qa.ts list",
    "qa:probe": "deno run -A --no-lock qa/probe.ts",
    "ci": "deno fmt --check && deno lint && deno task check && deno task test && deno task build"
  },
  "exclude": [
    "node_modules",
    "dist",
    ".git",
    "reference",
    "research",
    "vo",
    "sfx",
    "music",
    "art",
    "public/vo",
    "qa/reports",
    "qa/.build"
  ],
  "imports": {
    "vite": "npm:vite@8.3.1",
    "three": "npm:three@0.186.1",
    "@types/three": "npm:@types/three@0.186.0",
    "@std/assert": "jsr:@std/assert@1"
  },
  "nodeModulesDir": "auto"
}
